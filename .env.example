# Supabase — required on Vercel for live DB tools (fallback catalog used if missing)
# Get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side (same project URL; use service role for admin API routes)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: first admin user email (set is_admin=true in SQL after signup)
# UPDATE profiles SET is_admin = true WHERE email = 'you@example.com';

# Gemini AI Scout (optional)
GEMINI_API_KEY=your-gemini-api-key

# App (OAuth + password reset — local dev only; production uses window.location.origin)
PORT=3000
# Local:
VITE_APP_URL=http://localhost:3000
# Production (set in Vercel before build — must NOT be localhost):
# VITE_APP_URL=https://zorlai.xyz

# Set to "true" only when running Express locally (npm run dev). Leave unset on Vercel.
# VITE_USE_EXPRESS_API=false
