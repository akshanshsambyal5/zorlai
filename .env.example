# Supabase (required for full-stack mode)
# Get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side (same project URL; use service role for admin API routes)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: first admin user email (set is_admin=true in SQL after signup)
# UPDATE profiles SET is_admin = true WHERE email = 'you@example.com';

# Gemini AI Scout (optional)
GEMINI_API_KEY=your-gemini-api-key

# App (used for OAuth + password reset redirects)
PORT=3000
APP_URL=http://localhost:3000
VITE_APP_URL=http://localhost:3000
